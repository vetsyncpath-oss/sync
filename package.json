{
  "name": "@vetsyncpath/cloud-vault-sync",
  "version": "0.0.0",
  "private": true,
  "description": "Obsidian source-to-vault synchronizer",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "bench:state": "node scripts/bench-state.mjs",
    "verify": "npm test && npm run build",
    "dev": "node esbuild.config.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "esbuild": "0.28.2",
    "linkedom": "0.18.12",
    "obsidian": "1.13.1",
    "typescript": "5.8.3"
  },
  "main": "main.js"
}
